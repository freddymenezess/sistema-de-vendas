{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/pages/*"],
      "@widgets/*": ["src/components/widgets/*"],
      "@services/*": ["src/services/*"],
      "@data/*": ["src/data/*"],
      "@routes/*": ["src/routes/*"],
      "@auth/*": ["src/auth/*"],
      "@hooks/*": ["src/hooks/*"],
      "@templates/*": ["src/templates/*"],
      "@context/*": ["src/context/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
